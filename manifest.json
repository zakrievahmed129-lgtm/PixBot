{
  "manifest_version": 3,
  "name": "PixPilot - Assistant IA Universel & Pix",
  "version": "2.1.0",
  "description": "Assistant IA épuré disponible sur tous les sites (Chat quotidien + Mode Pix expert) propulsé par Gemini 3.5 Flash-Lite avec contrôle d'effort.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://*.pix.fr/*",
    "https://*.pix.org/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "commands": {
    "toggle-pixpilot": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Alt+P"
      },
      "description": "Afficher / masquer le terminal PixPilot"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.pix.fr/*",
        "https://*.pix.org/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
      ],
      "js": [
        "content/privacy-shield.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/jszip.min.js",
        "lib/xlsx.mini.js",
        "lib/html2canvas.min.js",
        "lib/pix-extractor.js",
        "lib/file-parser.js",
        "lib/query-engine.js",
        "lib/gemini.js",
        "lib/google-glass.js",
        "content/content.js"
      ],
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "content/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}

